# ══════════════════════════════════════════════
# AutoPentest AI — Environment Variables
# Copy to .env and fill in real values
# ══════════════════════════════════════════════

# ── General ────────────────────────────────────
APP_ENV=development
APP_NAME=AutoPentest AI
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-64
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL ─────────────────────────────────
POSTGRES_USER=autopentest
POSTGRES_PASSWORD=CHANGE-ME-strong-password
POSTGRES_DB=autopentest
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ──────────────────────────────────────
REDIS_PASSWORD=CHANGE-ME-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/2

# ── Clerk Auth ─────────────────────────────────
CLERK_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Stripe ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_STARTER_PRICE_ID=price_CHANGE_ME
STRIPE_PROFESSIONAL_PRICE_ID=price_CHANGE_ME
STRIPE_BUSINESS_PRICE_ID=price_CHANGE_ME
STRIPE_SINGLE_SCAN_PRICE_ID=price_CHANGE_ME

# ── Anthropic Claude ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
CLAUDE_MODEL=claude-opus-4-20250514

# ── Scanner ────────────────────────────────────
SCANNER_IMAGE=autopentest-scanner:latest
SCANNER_NETWORK=scanner-isolated
MAX_SCAN_DURATION_SECONDS=28800
SCAN_CONTAINER_MEMORY_LIMIT=2g
SCAN_CONTAINER_CPU_LIMIT=2.0

# ── External APIs (optional) ──────────────────
SHODAN_API_KEY=
HAVEIBEENPWNED_API_KEY=
VIRUSTOTAL_API_KEY=

# ── Next.js Frontend ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── CyberPulse Standalone Engine ───────────────
# Only needed when running cyberpulse/ directly (no Docker)
CYBERPULSE_PORT=7823
CYBERPULSE_HOST=0.0.0.0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CYBERPULSE_API_KEY=CHANGE-ME-api-key

# ── Deployment ─────────────────────────────────
DOMAIN=yourdomain.com
SSL_EMAIL=admin@yourdomain.com
