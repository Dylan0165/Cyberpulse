# ══════════════════════════════════════════════════════════
# CyberPulse — Environment Configuration
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════

# ── DeepSeek AI (ENIGE externe API) ──────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Web Interface ─────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=data/cyberpulse.log

# ── Scanner Defaults ──────────────────────────────────────
SCAN_TIMEOUT=28800
NMAP_TIMING=T4
MAX_THREADS=50
RATE_LIMIT=10000

# ── Wordlists (Kali Linux standaard paden) ───────────────
SECLISTS_PATH=/usr/share/seclists
WORDLIST_DIR=/usr/share/wordlists

# ── Optionele API Keys (voor modules 10 en 20) ──────────
# Laat leeg als je ze niet hebt — modules slaan dan over
HIBP_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# ── Scraper Schedule ─────────────────────────────────────
SCRAPER_ENABLED=true
SCRAPER_HOUR=3
SCRAPER_MINUTE=0

# ── Data Directory ────────────────────────────────────────
DATA_DIR=data
SCANS_DIR=data/scans
